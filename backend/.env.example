# ==========================================================
# HelpDeskGenie - Backend Active Environment (.env.example)
# ==========================================================
# Copy this file to `backend/.env` and update with your actual API credentials.

# 1. Google Gemini AI Engine
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 2. Pinecone Vector DB (RAG Grounding)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=helpdeskgenie-kb
PINECONE_ENVIRONMENT=us-east-1

# 3. JIRA Sandbox Credentials
JIRA_INSTANCE_URL=https://your-domain.atlassian.net
JIRA_USER_EMAIL=your-email@example.com
JIRA_API_TOKEN=your_jira_api_token_here
JIRA_PROJECT_KEY=ITSD

# 4. ServiceNow Sandbox Credentials
SERVICENOW_INSTANCE=your-instance.service-now.com
SERVICENOW_USERNAME=helpdeskgenie_api
SERVICENOW_PASSWORD=your_servicenow_instance_password

# 5. Twilio Sandbox MFA
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_VERIFY_SERVICE_SID=MOCK_SANDBOX

# 6. Active Directory / LDAP Sandbox
AD_LDAP_SERVER=ldap://ad-sandbox.corp.internal:389
AD_BIND_DN=CN=ServiceDeskBot,OU=ServiceAccounts,DC=corp,DC=internal
AD_BIND_PASSWORD=your_ad_service_account_password

# 7. Local Database
DATABASE_URL=sqlite:///./helpdeskgenie.db
