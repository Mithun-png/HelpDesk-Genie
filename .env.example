# ==========================================================
# HelpDeskGenie - Environment Variables Template (.env.example)
# ==========================================================
# Copy this file to `.env` and fill in your actual credentials.
# NEVER commit your real `.env` file to version control.

# Public URL of the FastAPI backend (used by the Vite frontend at build time)
VITE_API_URL=http://localhost:8000

# 1. LLM / AI Engine (Google Gemini)
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 2. Vector Database (Pinecone RAG Knowledge Base)
# Obtain from Pinecone Console: https://app.pinecone.io/
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=helpdeskgenie-kb
PINECONE_ENVIRONMENT=us-east-1

# 3. Ticketing System (Atlassian JIRA Sandbox)
# Obtain API Token from: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_INSTANCE_URL=https://your-domain.atlassian.net
JIRA_USER_EMAIL=your-email@example.com
JIRA_API_TOKEN=your_jira_api_token_here
JIRA_PROJECT_KEY=ITSD

# 4. ITSM Platform (ServiceNow Sandbox)
# Free developer instance from: https://developer.servicenow.com/
SERVICENOW_INSTANCE=your-instance.service-now.com
SERVICENOW_USERNAME=helpdeskgenie_api
SERVICENOW_PASSWORD=your_servicenow_instance_password

# 5. Two-Factor Identity Verification (Twilio Verify / Sandbox MFA)
# Obtain from Twilio Console: https://console.twilio.com/
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_VERIFY_SERVICE_SID=MOCK_SANDBOX

# 6. Active Directory / Microsoft Graph (LDAP Sandbox)
AD_LDAP_SERVER=ldap://ad-sandbox.corp.internal:389
AD_BIND_DN=CN=ServiceDeskBot,OU=ServiceAccounts,DC=corp,DC=internal
AD_BIND_PASSWORD=your_ad_service_account_password

# 7. Local Database (Audit Trail & Ticket Store)
DATABASE_URL=sqlite:///./helpdeskgenie.db
